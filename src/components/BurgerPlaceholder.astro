---
// Временная иллюстрация вместо hero-burger.png — уберём, когда появятся фото (этап 5)
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 600 460" role="img" aria-label="Двойной smash-бургер с чеддером">
  <defs>
    <radialGradient id="bp-glow" cx="50%" cy="60%" r="50%">
      <stop offset="0" stop-color="#ff5b1f" stop-opacity=".55" />
      <stop offset=".55" stop-color="#ff5b1f" stop-opacity=".12" />
      <stop offset="1" stop-color="#ff5b1f" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="bp-bun" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f0b060" />
      <stop offset=".7" stop-color="#c06a22" />
      <stop offset="1" stop-color="#8a4414" />
    </linearGradient>
    <linearGradient id="bp-patty" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#6b3a22" />
      <stop offset="1" stop-color="#2e170d" />
    </linearGradient>
  </defs>

  <ellipse cx="300" cy="270" rx="300" ry="200" fill="url(#bp-glow)" />
  <ellipse cx="300" cy="420" rx="230" ry="16" fill="#000" opacity=".45" />

  <!-- нижняя булка -->
  <path d="M110 350h380c0 40-30 62-80 62H190c-50 0-80-22-80-62Z" fill="url(#bp-bun)" />
  <!-- котлета 2 -->
  <path d="M86 300c0-14 12-22 26-22h376c14 0 26 8 26 22v22c0 16-12 28-28 28H114c-16 0-28-12-28-28Z" fill="url(#bp-patty)" />
  <path d="M86 304c20-8 34 6 52-2s30 8 48 0 32 6 52-2 30 8 50 0 32 6 50-2 30 8 50 0 32 6 48-2 28 6 46 2" fill="none" stroke="#a0582c" stroke-width="5" stroke-linecap="round" />
  <!-- сыр 2 -->
  <path d="M96 276h408l-16 18-10 34-14-34-40 12-22 30-16-30-70 6-12 22-14-22-80-4-18 30-10-32-50 6Z" fill="#f5b32b" />
  <!-- котлета 1 -->
  <path d="M80 236c0-14 12-22 26-22h388c14 0 26 8 26 22v22c0 16-12 28-28 28H108c-16 0-28-12-28-28Z" fill="url(#bp-patty)" />
  <path d="M80 240c20-8 34 6 52-2s30 8 48 0 32 6 52-2 30 8 50 0 32 6 50-2 30 8 50 0 32 6 48-2 28 6 50 2" fill="none" stroke="#a0582c" stroke-width="5" stroke-linecap="round" />
  <!-- сыр 1 -->
  <path d="M92 212h416l-14 20-8 40-16-38-48 10-20 36-18-34-64 4-14 26-14-26-84-2-16 38-12-40-52 8Z" fill="#f5b32b" />
  <!-- маринованный лук -->
  <path d="M110 204c30-12 60 8 90-2s60 10 90 0 60 10 90 0 60 10 110 2" fill="none" stroke="#c2507e" stroke-width="10" stroke-linecap="round" />
  <!-- верхняя булка -->
  <path d="M96 200c0-96 92-150 204-150s204 54 204 150c0 8-6 12-14 12H110c-8 0-14-4-14-12Z" fill="url(#bp-bun)" />
  <path d="M150 110c40-40 110-50 170-44" fill="none" stroke="#ffd9a0" stroke-width="10" stroke-linecap="round" opacity=".35" />
  <g fill="#f8e8c8">
    <ellipse cx="220" cy="100" rx="7" ry="4" transform="rotate(-20 220 100)" />
    <ellipse cx="290" cy="82" rx="7" ry="4" transform="rotate(10 290 82)" />
    <ellipse cx="360" cy="96" rx="7" ry="4" transform="rotate(25 360 96)" />
    <ellipse cx="250" cy="140" rx="7" ry="4" transform="rotate(5 250 140)" />
    <ellipse cx="330" cy="130" rx="7" ry="4" transform="rotate(-15 330 130)" />
    <ellipse cx="410" cy="140" rx="7" ry="4" transform="rotate(30 410 140)" />
    <ellipse cx="180" cy="150" rx="7" ry="4" transform="rotate(-30 180 150)" />
  </g>
</svg>
