---
import FoodPlaceholder from './FoodPlaceholder.astro';
import { combo, comboFullPrice, menu } from '../data/menu';

const comboItems = combo.items.map((id) => menu.find((m) => m.id === id)!);
---

<section id="deals" class="section pt-0 lg:pt-0" aria-labelledby="deals-title">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <h2 id="deals-title" class="sr-only">Сет и акция</h2>

    <div class="grid gap-6 lg:grid-cols-3">
      <!-- Сет: главное предложение, занимает две трети -->
      <article class="combo relative overflow-hidden rounded-[2.5rem] bg-iron p-6 sm:p-10 lg:col-span-2">
        <div class="grid items-center gap-8 sm:grid-cols-[minmax(0,15rem)_1fr]">
          <div class="combo-visual" aria-hidden="true">
            {comboItems.map((item) => (
              <FoodPlaceholder category={item.category} class="combo-piece rounded-full" />
            ))}
          </div>

          <div>
            <h3 class="combo-title display text-4xl sm:text-5xl">{combo.name}</h3>
            <p class="mt-3 text-smoke">{comboItems.map((i) => i.name).join(', ')}. Всё, что нужно на одного очень голодного человека.</p>
            <p class="mt-6 flex items-baseline gap-3">
              <span class="display text-4xl text-cheddar">{combo.price}&nbsp;₾</span>
              <s class="text-lg text-smoke" aria-label={`без сета ${comboFullPrice} лари`}>{comboFullPrice}&nbsp;₾</s>
            </p>
            <button type="button" class="btn btn-primary mt-6" data-add-to-cart={combo.id}>Добавить сет в корзину</button>
          </div>
        </div>
      </article>

      <!-- Акция вторника -->
      <article class="tuesday flex flex-col justify-between gap-8 rounded-[2.5rem] bg-cheddar p-6 text-soot sm:p-10">
        <h3 class="tuesday-title display">Жирный вторник</h3>
        <p class="text-lg font-medium">
          Каждый вторник второй бургер в заказе — за полцены. Скидка применится сама, промокод не нужен.
        </p>
      </article>
    </div>
  </div>
</section>

<style>
  .combo-title {
    font-stretch: 150%;
    font-weight: 900;
  }

  /* Три позиции сета, заходящие друг на друга */
  .combo-visual {
    display: flex;
    max-width: 15rem;
  }
  .combo-visual > :global(.combo-piece) {
    width: 45%;
    flex-shrink: 0;
    border: 4px solid var(--color-iron);
  }
  .combo-visual > :global(.combo-piece + .combo-piece) {
    margin-left: -17%;
  }
  .combo-visual > :global(.combo-piece:nth-child(2)) {
    transform: translateY(-18%);
  }
  .combo-visual > :global(.combo-piece svg) {
    width: 55%;
    height: auto;
  }

  .tuesday-title {
    font-size: clamp(2.5rem, 5vw, 3.75rem);
    font-stretch: 60%;
    font-weight: 900;
    line-height: 0.85;
  }
</style>
