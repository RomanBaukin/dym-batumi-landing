---
import FoodPlaceholder from './FoodPlaceholder.astro';
import { categories, menu, tagLabels } from '../data/menu';
---

<section id="menu" class="section" aria-labelledby="menu-title">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <h2 id="menu-title" class="section-title">Меню</h2>

      <div role="tablist" aria-label="Категории меню" class="tabs flex flex-wrap gap-2" data-tabs>
        {categories.map((c, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${c.id}`}
            aria-controls={`panel-${c.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            class="tab"
          >
            {c.label}
          </button>
        ))}
      </div>
    </div>

    {categories.map((c) => (
      <div role="tabpanel" id={`panel-${c.id}`} aria-labelledby={`tab-${c.id}`} tabindex="0" class="mt-10" data-panel>
        <ul class="grid gap-x-6 gap-y-10 sm:grid-cols-2 sm:gap-y-12 lg:grid-cols-3">
          {menu
            .filter((item) => item.category === c.id)
            .map((item) => (
              <li class="card">
                <FoodPlaceholder category={item.category} class="card-photo rounded-2xl sm:rounded-3xl" />
                <div class="card-body flex flex-col">
                <div class="flex items-start justify-between gap-4 sm:mt-5">
                  <h3 class="card-title display text-xl sm:text-2xl">{item.name}</h3>
                  <p class="price display shrink-0 text-xl text-cheddar sm:text-2xl">{item.price}&nbsp;₾</p>
                </div>
                {item.tags && (
                  <ul class="mt-3 flex flex-wrap gap-2" aria-label="Особенности">
                    {item.tags.map((t) => (
                      <li class:list={['tag', `tag-${t}`]}>{tagLabels[t]}</li>
                    ))}
                  </ul>
                )}
                <p class="mt-2 text-[0.95rem] text-smoke sm:mt-3 sm:text-base">{item.description}</p>
                <div class="mt-auto flex items-center justify-between gap-4 pt-4 sm:pt-5">
                  <span class="text-sm text-smoke">{item.size}</span>
                  <button
                    type="button"
                    class="btn btn-add min-h-11 px-5"
                    data-add-to-cart={item.id}
                    aria-label={`Добавить «${item.name}» в корзину`}
                  >
                    <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                      <path d="M8 2v12M2 8h12" />
                    </svg>
                    В корзину
                  </button>
                </div>
                </div>
              </li>
            ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .tabs {
    scrollbar-width: none;
  }

  .tab {
    flex-shrink: 0;
    min-height: 2.75rem;
    padding-inline: 1rem;
    border-radius: 999px;
    border: 2px solid color-mix(in oklab, var(--color-brioche) 20%, transparent);
    font-weight: 600;
    color: var(--color-smoke);
    transition:
      color 0.2s,
      background-color 0.2s,
      border-color 0.2s;
  }
  .tab:hover {
    color: var(--color-brioche);
  }
  .tab[aria-selected='true'] {
    background: var(--color-brioche);
    border-color: var(--color-brioche);
    color: var(--color-soot);
  }

  /* Мобилка: фото слева, как в приложениях доставки. С sm — фото сверху. */
  .card {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    align-items: start;
    gap: 1rem;
  }
  @media (min-width: 40rem) {
    .card {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }
    .card-body {
      flex: 1;
    }
    .card-title {
      font-stretch: 115%;
    }
  }

  .card-title {
    min-width: 0;
    font-stretch: 100%;
    font-weight: 800;
    line-height: 1.05;
  }

  .price {
    font-stretch: 100%;
    font-weight: 800;
  }

  .btn-add {
    border: 2px solid var(--color-ember);
    color: var(--color-ember);
  }
  .btn-add:hover {
    background: var(--color-ember);
    color: var(--color-soot);
  }

  .tag {
    padding: 0.125rem 0.625rem;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 600;
    border: 1px solid currentColor;
  }
  .tag-hit {
    color: var(--color-cheddar);
  }
  .tag-spicy {
    color: var(--color-ember);
  }
  .tag-local {
    color: var(--color-brioche);
  }
</style>

<script>
  // Табы по паттерну WAI-ARIA: стрелки переключают, Home/End — к краям.
  // Без JS показываются все категории подряд.
  const tablist = document.querySelector<HTMLElement>('[data-tabs]');
  if (tablist) {
    const tabs = [...tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls')!)!);

    const select = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        const active = i === index;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        panels[i].hidden = !active;
      });
      if (focus) tabs[index].focus();
    };

    select(0);

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (e) => {
        const last = tabs.length - 1;
        const next = { ArrowRight: i === last ? 0 : i + 1, ArrowLeft: i === 0 ? last : i - 1, Home: 0, End: last }[e.key];
        if (next === undefined) return;
        e.preventDefault();
        select(next, true);
      });
    });
  }
</script>
