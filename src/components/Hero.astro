---
import BurgerPlaceholder from './BurgerPlaceholder.astro';

const facts = [
  'Smash на чугуне 250°',
  'Фарш крутим каждое утро',
  'Бриошь из пекарни на Руставели',
  'Работаем до 2 ночи',
  'Жир не враг',
];
---

<section id="top" class="relative overflow-hidden">
  <div class="smash-wrap mx-auto max-w-7xl px-4 pt-6 sm:px-6 lg:pt-10">
    <h1 class="smash-word display text-brioche">
      ДЫМ<span class="sr-only"> — smash-бургеры в Батуми</span>
    </h1>
  </div>

  <div class="mx-auto grid max-w-7xl items-start gap-6 px-4 pb-12 sm:px-6 lg:grid-cols-12 lg:gap-10 lg:pb-20">
    <div class="visual relative z-10 lg:order-2 lg:col-span-7">
      <BurgerPlaceholder class="mx-auto w-full max-w-[290px] sm:max-w-[420px] lg:max-w-[640px]" />
    </div>

    <div class="pt-2 lg:order-1 lg:col-span-5 lg:pt-16">
      <p class="tagline display text-[clamp(1.75rem,4.2vw,2.75rem)] text-cheddar">Smash&#8209;бургеры на&nbsp;открытом огне</p>
      <p class="mt-5 max-w-[38ch] text-smoke">
        Прижимаем котлету к&nbsp;чугуну, раскалённому до&nbsp;250°, пока края не&nbsp;станут кружевными и&nbsp;хрустящими. Привезём горячими за&nbsp;40&nbsp;минут в&nbsp;любой район Батуми.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#menu" class="btn btn-primary">Выбрать бургер</a>
        <a href="#delivery" class="btn btn-ghost">Куда доставляем</a>
      </div>
    </div>
  </div>

  <div class="marquee bg-ember py-3 text-soot">
    <div class="marquee-track">
      {[false, true].map((hidden) => (
        <ul class="marquee-list" aria-hidden={hidden ? 'true' : undefined}>
          {facts.map((fact) => (
            <li class="flex items-center gap-6">
              <span>{fact}</span>
              <svg aria-hidden="true" width="18" height="22" viewBox="0 0 18 22" fill="currentColor">
                <path d="M9 0c1 5 8 8 8 14a8 8 0 0 1-16 0c0-3 2-5 3-6 0 3 2 4 3 4-1-5 0-9 2-12Z" />
              </svg>
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</section>

<style>
  /*
    Главный вау-момент первого экрана — «смэш»: слово ДЫМ появляется узким,
    а потом его «придавливает прессом», как котлету на плите — буквы расплющиваются
    и расползаются во всю ширину. Работает на оси ширины (wdth) Science Gothic.
  */
  .smash-wrap {
    container-type: inline-size;
  }

  .smash-word {
    font-size: 18.25cqw; /* при font-stretch 200% слово ровно заполняет контейнер */
    font-weight: 900;
    font-stretch: 200%;
    line-height: 0.78;
    letter-spacing: -0.02em;
    white-space: nowrap;
    transform-origin: 0 100%;
    animation: smash 1.1s 0.2s both;
  }

  @keyframes smash {
    0%,
    40% {
      font-stretch: 50%;
      transform: scaleY(1);
      animation-timing-function: var(--ease-press);
    }
    62% {
      font-stretch: 200%;
      transform: scaleY(0.7);
      animation-timing-function: cubic-bezier(0.2, 0.8, 0.3, 1);
    }
    80% {
      transform: scaleY(1.05);
    }
    100% {
      font-stretch: 200%;
      transform: scaleY(1);
    }
  }

  /* Бургер «садится» на нижний край букв */
  .visual {
    margin-top: -5vw;
  }
  @media (min-width: 64rem) {
    .visual {
      margin-top: -6.5vw;
    }
  }

  .tagline {
    font-stretch: 100%;
    font-weight: 800;
  }

  .marquee {
    overflow: hidden;
    font-family: var(--font-display);
    font-stretch: 125%;
    font-weight: 800;
    font-size: 1.125rem;
  }
  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 38s linear infinite;
  }
  .marquee-list {
    display: flex;
    flex-shrink: 0;
    gap: 1.5rem;
    padding-right: 1.5rem;
    white-space: nowrap;
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .smash-word,
    .marquee-track {
      animation: none;
    }
  }
</style>
