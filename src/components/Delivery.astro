---
import { business, deliveryZones } from '../data/menu';
---

<section id="delivery" class="section" aria-labelledby="delivery-title">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <h2 id="delivery-title" class="section-title">Доставка по Батуми</h2>

    <div class="mt-12 grid gap-10 lg:mt-16 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <ul class="grid gap-6">
          {deliveryZones.map((z) => (
            <li class="zone flex gap-4">
              <span class:list={['swatch', `swatch-${z.color}`]} aria-hidden="true"></span>
              <div>
                <h3 class="font-semibold">{z.name}</h3>
                <p class="mt-1 text-smoke">
                  Привезём за {z.time}. Доставка {z.fee}&nbsp;₾, от {z.freeFrom}&nbsp;₾ — бесплатно.
                </p>
              </div>
            </li>
          ))}
        </ul>

        <dl class="mt-10 grid gap-5 border-t border-brioche/15 pt-8">
          <div>
            <dt class="text-smoke">Часы работы</dt>
            <dd class="mt-1 font-semibold">{business.hours}, последний заказ в {business.lastOrder}</dd>
          </div>
          <div>
            <dt class="text-smoke">Минимальный заказ</dt>
            <dd class="mt-1 font-semibold">{business.minOrder}&nbsp;₾</dd>
          </div>
          <div>
            <dt class="text-smoke">Самовывоз</dt>
            <dd class="mt-1 font-semibold">{business.address}</dd>
          </div>
        </dl>
      </div>

      <div class="map lg:col-span-7" data-delivery-map role="region" aria-label="Карта зон доставки">
        <p class="map-loading text-smoke">Загружаем карту…</p>
      </div>
    </div>
  </div>
</section>

<style>
  .swatch {
    flex-shrink: 0;
    width: 1rem;
    height: 1rem;
    margin-top: 0.3rem;
    border-radius: 999px;
  }
  .swatch-ember {
    background: var(--color-ember);
  }
  .swatch-cheddar {
    background: var(--color-cheddar);
  }
  .swatch-brioche {
    background: var(--color-brioche);
  }

  .map {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 24rem;
    border-radius: 2rem;
    overflow: hidden;
    background: var(--color-iron);
    /* поверх тайлов Leaflet — чтобы скругление не терялось */
    isolation: isolate;
  }
  @media (min-width: 64rem) {
    .map {
      min-height: 32rem;
    }
  }

  /* Leaflet в фирменных цветах */
  .map :global(.leaflet-container) {
    background: var(--color-iron);
    font: inherit;
  }
  /* Светлые тайлы OSM → тёплая «ночная» карта в палитре сайта */
  .map :global(.leaflet-tile-pane) {
    filter: invert(1) hue-rotate(180deg) sepia(0.35) saturate(0.6) brightness(0.8) contrast(0.95);
  }
  .map :global(.leaflet-control-attribution) {
    background: rgb(23 17 13 / 0.8);
    color: var(--color-smoke);
  }
  .map :global(.leaflet-control-attribution a) {
    color: var(--color-brioche);
  }
  .map :global(.leaflet-bar a) {
    background: var(--color-soot);
    color: var(--color-brioche);
    border-color: color-mix(in oklab, var(--color-brioche) 15%, transparent);
  }
  .map :global(.leaflet-popup-content-wrapper),
  .map :global(.leaflet-popup-tip) {
    background: var(--color-soot);
    color: var(--color-brioche);
  }
  .map :global(.leaflet-popup-close-button) {
    color: var(--color-smoke);
  }
  .map :global(.map-pin span) {
    display: grid;
    place-items: center;
    height: 100%;
    border-radius: 999px;
    background: var(--color-ember);
    color: var(--color-soot);
    font-family: var(--font-display);
    font-stretch: 150%;
    font-weight: 900;
    box-shadow: 0 6px 18px rgb(0 0 0 / 0.5);
  }
</style>

<script>
  // Leaflet (~40 КБ) и тайлы грузим, только когда блок доставки почти на экране
  const el = document.querySelector<HTMLElement>('[data-delivery-map]');
  if (el) {
    const io = new IntersectionObserver(
      async ([entry]) => {
        if (!entry.isIntersecting) return;
        io.disconnect();
        try {
          const { mountMap } = await import('../scripts/delivery-map');
          el.replaceChildren();
          mountMap(el);
        } catch {
          el.innerHTML = '<p class="px-6 text-center text-smoke">Карта не загрузилась. Все зоны и условия — в списке.</p>';
        }
      },
      { rootMargin: '600px 0px' },
    );
    io.observe(el);
  }
</script>
