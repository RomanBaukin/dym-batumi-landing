---
// Отзывы и люди вымышленные — это демо-проект, портреты сгенерированы.
import { Image } from 'astro:assets';
import { photo } from '../data/photos';

const reviews = [
  {
    name: 'Артём',
    avatar: 'avatar-2',
    place: 'переехал из Москвы',
    order: 'Классика дыма',
    text: 'Полгода искал в Батуми нормальный смэш. Нашёл. Края хрустят, булка не разваливается, привезли за 35 минут.',
  },
  {
    name: 'Нино',
    avatar: 'avatar-1',
    place: 'Старый Батуми',
    order: 'Аджарский',
    text: 'Заказала в час ночи после смены. Желток потёк ровно так, как я надеялась. Теперь это мой способ пережить понедельник.',
  },
  {
    name: 'Гига',
    avatar: 'avatar-3',
    place: 'Новый бульвар',
    order: 'Фри по-батумски',
    text: 'Фри по-батумски — преступление против диеты, и я соучастник. Беру каждую пятницу.',
  },
  {
    name: 'Ольга',
    avatar: 'avatar-4',
    place: 'Махинджаури',
    order: 'Дымный сет',
    text: 'Живём за городом, думала — не довезут. Довезли горячим, курьер ещё и лишний соус положил.',
  },
];

const [featured, ...rest] = reviews;
---

<section id="reviews" class="section" aria-labelledby="reviews-title">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <h2 id="reviews-title" class="section-title max-w-[14ch]">Говорят те, кто уже попробовал</h2>

    <div class="mt-12 grid gap-10 lg:mt-16 lg:grid-cols-12 lg:gap-16">
      <figure class="lg:col-span-7">
        <blockquote class="featured display text-brioche">
          <p>«{featured.text}»</p>
        </blockquote>
        <figcaption class="mt-8 flex items-center gap-4">
          <Image src={photo(featured.avatar)} alt="" widths={[56, 112, 168]} sizes="56px" class="avatar avatar-lg" />
          <span>
            <span class="block font-semibold">{featured.name}, {featured.place}</span>
            <span class="block text-smoke">Заказ: «{featured.order}»</span>
          </span>
        </figcaption>
      </figure>

      <ul class="grid content-start gap-8 lg:col-span-5">
        {rest.map((r) => (
          <li>
            <figure class="border-t border-brioche/15 pt-6">
              <blockquote>
                <p>«{r.text}»</p>
              </blockquote>
              <figcaption class="mt-4 flex items-center gap-3">
                <Image src={photo(r.avatar)} alt="" widths={[44, 88, 132]} sizes="44px" class="avatar" />
                <span class="text-sm">
                  <span class="block font-semibold">{r.name}, {r.place}</span>
                  <span class="block text-smoke">Заказ: «{r.order}»</span>
                </span>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .featured {
    font-size: clamp(1.625rem, 3.4vw, 2.625rem);
    font-stretch: 100%;
    font-weight: 700;
    line-height: 1.15;
    text-wrap: pretty;
  }

  .avatar {
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    object-fit: cover;
    background: var(--color-iron);
  }
  .avatar-lg {
    width: 3.5rem;
    height: 3.5rem;
  }
</style>
