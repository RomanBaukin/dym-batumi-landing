---
// Слой взрыв-схемы: вырезанное фото на прозрачном фоне (layer-*.png из prompts.md)
import { Picture } from 'astro:assets';
import { photo } from '../data/photos';

export type Layer = 'bun-top' | 'onion' | 'patty-cheese' | 'sauce' | 'bun-bottom';

interface Props {
  layer: Layer;
  class?: string;
}

const { layer, class: className } = Astro.props;
// Реальную ширину считает скрипт взрыв-схемы по высоте экрана: ~300 px на десктопе, ~240 на мобилке
---

<Picture
  src={photo(`layer-${layer}`)}
  alt=""
  widths={[240, 320, 480, 640, 832]}
  sizes="(min-width: 64rem) 320px, 240px"
  formats={['avif', 'webp']}
  class={className}
  draggable="false"
/>
