---
const links = [
  { href: '#menu', label: 'Меню' },
  { href: '#delivery', label: 'Доставка' },
  { href: '#reviews', label: 'Отзывы' },
  { href: '#faq', label: 'Вопросы' },
];
---

<header class="sticky top-0 z-50 border-b border-brioche/10 bg-soot/85 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-7xl items-center gap-6 px-4 sm:px-6">
    <a href="#top" class="logo display text-2xl text-brioche" aria-label="ДЫМ — на главную">ДЫМ</a>

    <nav aria-label="Разделы" class="ml-auto hidden md:block">
      <ul class="flex gap-7 text-[0.95rem] font-medium">
        {links.map((l) => (
          <li><a href={l.href} class="text-smoke transition-colors hover:text-brioche">{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <button
      type="button"
      class="ml-auto flex min-h-11 items-center gap-2 rounded-full bg-iron px-4 font-semibold md:ml-0"
      data-cart-button
    >
      <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 7h12l-1 13H7L6 7Z" /><path d="M9 7a3 3 0 0 1 6 0" />
      </svg>
      <!-- Доступное имя собирается из содержимого: «Корзина 0 товаров» — совпадает с тем, что видно -->
      <span class="sr-only sm:not-sr-only">Корзина</span>
      <span class="grid h-6 min-w-6 place-items-center rounded-full bg-cheddar px-1.5 text-sm text-soot" data-cart-count>0</span>
      <span class="sr-only" data-cart-noun>товаров</span>
    </button>
  </div>
</header>

<style>
  .logo {
    font-stretch: 200%;
    font-weight: 900;
    letter-spacing: -0.02em;
  }
</style>
