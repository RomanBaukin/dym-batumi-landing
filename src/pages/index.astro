---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Inside from '../components/Inside.astro';
import Menu from '../components/Menu.astro';
import Deals from '../components/Deals.astro';
import Reviews from '../components/Reviews.astro';
import Delivery from '../components/Delivery.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import Cart from '../components/Cart.astro';
---

<Layout
  title="ДЫМ — smash-бургеры в Батуми"
  description="Smash-бургеры на открытом огне с доставкой по Батуми за 40 минут. Демо-проект Mr. Web."
>
  <Header />
  <main>
    <Hero />
    <Inside />
    <Menu />
    <Deals />
    <Reviews />
    <Delivery />
    <Faq />
  </main>
  <Footer />
  <Cart />
</Layout>
